<?xml version="1.0" encoding="UTF-8"?>
<scene name="cornell_box_environment">
  <render>
    <image_width>1280</image_width>
    <image_height>720</image_height>
    <samples_per_pixel>7000</samples_per_pixel>
    <max_depth>15</max_depth>
  </render>

  <environment>
    <texture>environments/studio_softboxes.hdr</texture>
    <intensity>1.5</intensity>
    <rotation_degrees>25.0</rotation_degrees>
  </environment>

  <camera>
    <position x="0" y="-1" z="9.4"/>
    <look_at x="0" y="-1" z="0"/>
    <up x="0" y="1" z="0"/>
    <fov>60</fov>
    <aspect_ratio>auto</aspect_ratio>
    <aperture>0.1</aperture>
    <focus_distance>10.0</focus_distance>
  </camera>

  <materials>
    <material id="white" type="lambertian">
      <color r="0.8" g="0.8" b="0.8"/>
    </material>
    <material id="red" type="lambertian">
      <color r="0.8" g="0.2" b="0.2"/>
    </material>
    <material id="blue" type="lambertian">
      <color r="0.2" g="0.2" b="0.8"/>
    </material>
    <material id="metal" type="metal">
      <color r="0.8" g="0.7" b="0.6"/>
      <fuzz>0.47</fuzz>
    </material>
    <material id="green" type="lambertian">
      <color r="0.2" g="0.8" b="0.2"/>
    </material>
  </materials>

  <objects>
    <!-- Ceiling split into four quads to create a skylight opening -->
    <quad material="white">
      <corner x="-5" y="3.5" z="-5"/>
      <u_edge x="10" y="0" z="0"/>
      <v_edge x="0" y="0" z="4"/>
    </quad>

    <quad material="white">
      <corner x="-5" y="3.5" z="1"/>
      <u_edge x="10" y="0" z="0"/>
      <v_edge x="0" y="0" z="4"/>
    </quad>

    <quad material="white">
      <corner x="-5" y="3.5" z="-1"/>
      <u_edge x="4" y="0" z="0"/>
      <v_edge x="0" y="0" z="2"/>
    </quad>

    <quad material="white">
      <corner x="1" y="3.5" z="-1"/>
      <u_edge x="4" y="0" z="0"/>
      <v_edge x="0" y="0" z="2"/>
    </quad>

    <quad material="white">
      <corner x="-5" y="-5" z="-5"/>
      <u_edge x="10" y="0" z="0"/>
      <v_edge x="0" y="0" z="10"/>
    </quad>

    <quad material="red">
      <corner x="-4" y="-5" z="-5"/>
      <u_edge x="0" y="10" z="0"/>
      <v_edge x="0" y="0" z="20"/>
    </quad>

    <quad material="blue">
      <corner x="4" y="-5" z="-5"/>
      <u_edge x="0" y="10" z="0"/>
      <v_edge x="0" y="0" z="20"/>
    </quad>

    <quad material="white">
      <corner x="-4" y="-5" z="-5"/>
      <u_edge x="10" y="0" z="0"/>
      <v_edge x="0" y="10" z="0"/>
    </quad>

    <quad material="white">
      <corner x="-4" y="-5" z="9.5"/>
      <u_edge x="10" y="0" z="0"/>
      <v_edge x="0" y="10" z="0"/>
    </quad>

    <box material="metal">
      <center x="-1.3" y="-2.5" z="-2.0"/>
      <size x="2.4" y="6" z="2.4"/>
      <rotation y="-30"/>
    </box>

    <box material="green">
      <center x="1.8" y="-4" z="-0.2"/>
      <size x="2" y="2" z="2"/>
      <rotation y="20"/>
    </box>
  </objects>
</scene>
